{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/etete-agbabune.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Etete Agbabune.vcf\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/shop",
      "destination": "/shop.html"
    }
  ],
  "redirects": [
    {
      "source": "/privacy",
      "destination": "/policies#privacy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/policies#terms",
      "permanent": true
    },
    {
      "source": "/accessibility",
      "destination": "/policies#accessibility",
      "permanent": true
    }
  ]
}
